# Single source of config for `docker compose`. Server reads these via env_file,
# the VITE_* ones are baked into the client bundle at build time.
# Copy to .env and fill in. Already gitignored.

# --- database -------------------------------------------------------------
# Inside a container `localhost` is the container. If Postgres runs on the host,
# use host.docker.internal instead of localhost (Docker Desktop resolves it;
# on plain Docker Engine the server service needs extra_hosts:
#   extra_hosts: ["host.docker.internal:host-gateway"]).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ark

# --- supabase -------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# optional, defaults are derived from SUPABASE_URL
# SUPABASE_JWT_ISSUER=
# SUPABASE_JWKS_URL=
# SUPABASE_JWT_AUDIENCE=

# --- cors -----------------------------------------------------------------
# Requests are same-origin via the nginx /api proxy, so this is only needed if
# you also hit the API on another port. Must be non-empty or config.py raises.
BACKEND_CORS_ORIGINS=http://localhost:8080

# --- optional -------------------------------------------------------------
# Without this the /agent/chat endpoint raises at call time, not at boot.
GROQ_API_KEY=
# Seeds an admin on first boot. Leave ADMIN_PASSWORD empty to have one generated
# and logged. Delete the row after first login - must_change_password is forced.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- client build args ----------------------------------------------------
VITE_API_BASE_URL=/api
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...